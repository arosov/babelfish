{
  "$defs": {
    "ActivationDetectionConfig": {
      "properties": {
        "icon_only": {
          "default": false,
          "title": "Icon Only",
          "type": "boolean"
        },
        "overlay_mode": {
          "default": false,
          "title": "Overlay Mode",
          "type": "boolean"
        }
      },
      "title": "ActivationDetectionConfig",
      "type": "object"
    },
    "CacheConfig": {
      "properties": {
        "cache_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Dir"
        }
      },
      "title": "CacheConfig",
      "type": "object"
    },
    "CalibrationConfig": {
      "description": "The persisted calibration cache (ADR 0013): bench once per\nacceleration backend, keyed by fingerprint, canary-checked every\nlaunch.\n\nDeliberately NOT `pipeline.performance` \u2014 that key keeps its\nlive strip-migration semantics from the ADR 0011 rework; calibration\noutput lives in its own top-level section so stale pacing keys are\nstill wiped while benched entries survive.",
      "properties": {
        "schema_version": {
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/CalibrationProfileEntry"
          },
          "title": "Profiles",
          "type": "object"
        }
      },
      "title": "CalibrationConfig",
      "type": "object"
    },
    "CalibrationProfileEntry": {
      "description": "One benched calibration profile, persisted under its fingerprint in\nthe `calibration` section (ADR 0013).\n\nThe profile fields are the operating point (window, throttle, padding,\ntier label); `operating_cost_ms` is the Ghost cohort cost measured at\nthat window; `cells` is the full measured Ghost probe matrix (fixture \u2192\nwindow \u2192 median ms) \u2014 kept for the canary's reference and for\nsupport/diagnostic value; `final_rtfx` is informational.",
      "properties": {
        "ghost_throttle_ms": {
          "title": "Ghost Throttle Ms",
          "type": "integer"
        },
        "ghost_window_s": {
          "title": "Ghost Window S",
          "type": "number"
        },
        "ghost_padding_s": {
          "title": "Ghost Padding S",
          "type": "number"
        },
        "min_padding_s": {
          "title": "Min Padding S",
          "type": "number"
        },
        "tier": {
          "title": "Tier",
          "type": "string"
        },
        "operating_cost_ms": {
          "title": "Operating Cost Ms",
          "type": "number"
        },
        "final_rtfx": {
          "title": "Final Rtfx",
          "type": "number"
        },
        "cells": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object"
          },
          "title": "Cells",
          "type": "object"
        },
        "benched_at": {
          "default": "",
          "title": "Benched At",
          "type": "string"
        }
      },
      "required": [
        "ghost_throttle_ms",
        "ghost_window_s",
        "tier",
        "operating_cost_ms"
      ],
      "title": "CalibrationProfileEntry",
      "type": "object"
    },
    "HardwareConfig": {
      "properties": {
        "device": {
          "title": "Device",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "microphone_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Microphone Name"
        },
        "quantization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantization"
        }
      },
      "title": "HardwareConfig",
      "type": "object"
    },
    "HardwareStatus": {
      "properties": {
        "active_device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Device"
        },
        "active_device_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Device Name"
        },
        "vram_total_gb": {
          "title": "Vram Total Gb",
          "type": "number"
        },
        "vram_used_baseline_gb": {
          "title": "Vram Used Baseline Gb",
          "type": "number"
        },
        "vram_used_model_gb": {
          "title": "Vram Used Model Gb",
          "type": "number"
        }
      },
      "title": "HardwareStatus",
      "type": "object"
    },
    "PipelineConfig": {
      "properties": {
        "silence_threshold_ms": {
          "default": 400,
          "title": "Silence Threshold Ms",
          "type": "integer"
        },
        "pre_roll_ms": {
          "default": 300,
          "title": "Pre Roll Ms",
          "type": "integer"
        }
      },
      "title": "PipelineConfig",
      "type": "object"
    },
    "SeparatorPolicy": {
      "enum": [
        "trailing",
        "leading",
        "never"
      ],
      "title": "SeparatorPolicy",
      "type": "string"
    },
    "ServerConfig": {
      "properties": {
        "host": {
          "default": "127.0.0.1",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 8123,
          "title": "Port",
          "type": "integer"
        }
      },
      "title": "ServerConfig",
      "type": "object"
    },
    "ShortcutsConfig": {
      "properties": {
        "toggle_listening": {
          "default": "Ctrl+Space",
          "title": "Toggle Listening",
          "type": "string"
        }
      },
      "title": "ShortcutsConfig",
      "type": "object"
    },
    "SystemInputConfig": {
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "type_ghost": {
          "default": false,
          "title": "Type Ghost",
          "type": "boolean"
        },
        "typing_throttle_ms": {
          "default": 350,
          "title": "Typing Throttle Ms",
          "type": "integer"
        },
        "separator": {
          "$ref": "#/$defs/SeparatorPolicy",
          "default": "trailing"
        }
      },
      "title": "SystemInputConfig",
      "type": "object"
    },
    "TranscriptionWindowConfig": {
      "properties": {
        "always_on_top": {
          "default": true,
          "title": "Always On Top",
          "type": "boolean"
        }
      },
      "title": "TranscriptionWindowConfig",
      "type": "object"
    },
    "UIConfig": {
      "properties": {
        "notifications": {
          "default": true,
          "title": "Notifications",
          "type": "boolean"
        },
        "shortcuts": {
          "$ref": "#/$defs/ShortcutsConfig"
        },
        "activation_detection": {
          "$ref": "#/$defs/ActivationDetectionConfig"
        },
        "transcription_window": {
          "$ref": "#/$defs/TranscriptionWindowConfig"
        }
      },
      "title": "UIConfig",
      "type": "object"
    },
    "VoiceConfig": {
      "properties": {
        "wakeword": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wakeword"
        },
        "stop_wakeword": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Wakeword"
        },
        "wakeword_sensitivity": {
          "title": "Wakeword Sensitivity",
          "type": "number"
        },
        "stop_wakeword_sensitivity": {
          "title": "Stop Wakeword Sensitivity",
          "type": "number"
        },
        "stop_words": {
          "items": {
            "type": "string"
          },
          "title": "Stop Words",
          "type": "array"
        }
      },
      "title": "VoiceConfig",
      "type": "object"
    }
  },
  "properties": {
    "hardware": {
      "$ref": "#/$defs/HardwareConfig"
    },
    "status": {
      "$ref": "#/$defs/HardwareStatus"
    },
    "pipeline": {
      "$ref": "#/$defs/PipelineConfig"
    },
    "calibration": {
      "$ref": "#/$defs/CalibrationConfig"
    },
    "system_input": {
      "$ref": "#/$defs/SystemInputConfig"
    },
    "voice": {
      "$ref": "#/$defs/VoiceConfig"
    },
    "ui": {
      "$ref": "#/$defs/UIConfig"
    },
    "server": {
      "$ref": "#/$defs/ServerConfig"
    },
    "cache": {
      "$ref": "#/$defs/CacheConfig"
    }
  },
  "title": "BabelfishConfig",
  "type": "object"
}